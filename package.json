{
  "name": "postloom",
  "private": true,
  "description": "Send beautiful, personalized emails from a spreadsheet.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @postloom/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @postloom/desktop e2e",
    "package": "pnpm --filter @postloom/desktop package",
    "e2e:perf": "pnpm --filter @postloom/desktop e2e:perf"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
