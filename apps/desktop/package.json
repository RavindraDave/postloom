{
  "name": "@postloom/desktop",
  "productName": "Postloom",
  "version": "1.0.0",
  "private": true,
  "description": "Send beautiful, personalized emails from a spreadsheet.",
  "author": "R2DSolutions",
  "homepage": "https://github.com/RavindraDave/postloom",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p .storybook/tsconfig.json",
    "e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --publish never",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "e2e:perf": "electron-vite build && playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@postloom/recipients": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "html-to-text": "10.0.1",
    "kysely": "0.29.6",
    "mammoth": "^1.13.0",
    "mjml": "5.4.1",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@mantine/notifications": "9.6.3",
    "@playwright/test": "1.63.0",
    "@postloom/contracts": "workspace:*",
    "@postloom/core": "workspace:*",
    "@postloom/db": "workspace:*",
    "@postloom/editor": "workspace:*",
    "@postloom/email": "workspace:*",
    "@postloom/sending": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-query": "5.104.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "i18next": "26.4.2",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "selfsigned": "5.5.0",
    "smtp-server": "3.19.14",
    "storybook": "10.6.0",
    "vite": "7.3.6",
    "zod": "4.6.5"
  }
}
